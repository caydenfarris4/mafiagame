# The UI talks to the game server over a WebSocket. By default that's
# same-origin (/ws on whatever host serves the app), so you usually need NO env
# vars at all — `npm run preview` and `npm run deploy` work out of the box.
#
# Only set this to override the WebSocket URL, e.g. if you run the worker on a
# different host than the UI during development:
# NEXT_PUBLIC_GAME_WS_URL="ws://localhost:8787/ws"
