# Local development environment.
# SQLite file-based DB for dev. For production swap the schema provider to
# postgresql and set this to a hosted Postgres connection string.
DATABASE_URL="file:./dev.db"

# Must be at least 32 characters. Generate a real one for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_32+_char_random_string"

# Base URL used when generating QR code links. In production set to https://campushome.us
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
