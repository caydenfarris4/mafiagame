# Frontend environment for the Next.js client.
#
# The Next.js app is just the TV + phone UI; all game logic lives in the Python
# server (see ./server). Point the client at that server's WebSocket:

# Local dev (run the Python server with `uvicorn app.main:app --port 8000`):
NEXT_PUBLIC_GAME_WS_URL="ws://localhost:8000/ws"

# In production, set this to your deployed server, e.g.
#   NEXT_PUBLIC_GAME_WS_URL="wss://your-game-server.example.com/ws"
# If unset, the client falls back to ws(s)://<this-origin>/ws (use a reverse
# proxy that forwards /ws to the Python server).
