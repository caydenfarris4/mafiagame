# Local development only (next dev). Production runs on Cloudflare Workers + D1,
# where these are configured in wrangler.jsonc (vars) and via `wrangler secret`.

# Local SQLite file, used by the Prisma CLI (migrate/generate) and the libSQL
# adapter. Resolved relative to the prisma/ directory, so this is prisma/dev.db.
DATABASE_URL="file:./dev.db"

# Session cookie signing key. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production, set as a Worker secret: `npx wrangler secret put SESSION_SECRET`.
SESSION_SECRET="replace_with_32+_char_random_string"

# Base URL used to build QR-code links. Local: http://localhost:3000.
# In production this comes from wrangler.jsonc vars (https://deadinthewater.caydenfarris.net).
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Comma-separated ISO country codes allowed to log in. A login from any other
# (known) country is blocked at the door — this keeps bots that scrape the public
# URL out of the game. Defaults to "US". Set this to wherever the party is held
# (e.g. "US,CA"). Logins with unknown geo (local dev) are always allowed.
ALLOWED_COUNTRIES="US"
