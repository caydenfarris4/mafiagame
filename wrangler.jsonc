{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafiagame",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-03-25",
  // Serve the exported Next.js UI (./out) as static assets. Requests that match
  // a file are served directly; everything else (i.e. /ws) hits the Worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./out"
  },
  "observability": {
    "enabled": true
  },
  // One Durable Object class = one live room (keyed by room code). Holds the
  // game state and the room's WebSockets in memory.
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  // SQLite-backed DO class (works on both Free and Paid plans). We don't use
  // storage today, but this is the forward-compatible declaration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
