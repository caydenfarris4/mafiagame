{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafiagame",
  "main": ".open-next/worker.js",
  // Build the OpenNext worker before any deploy/upload. This lets Cloudflare's
  // git-connected Workers Builds (and `wrangler deploy`) generate
  // .open-next/worker.js automatically — no separate build command needed.
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // The D1 database the app talks to. Create it with:
  //   npx wrangler d1 create dead-in-the-water
  // then paste the printed database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dead-in-the-water",
      "database_id": "dbcc04fc-42f9-4119-a897-c94314c67cfd",
      "migrations_dir": "cf-migrations"
    }
  ],
  "vars": {
    // Public base URL used to build QR links.
    "NEXT_PUBLIC_BASE_URL": "https://deadinthewater.caydenfarris.net",
    // Countries (ISO-2, comma-separated) allowed to log in. A login from any
    // other known country is blocked, keeping bots that scrape the public URL
    // out of the game. Set this to wherever the party is held — US + CA here,
    // since the lake house is in northern Washington near the Canadian border
    // (border-area carriers sometimes geolocate a US phone as CA, or vice versa).
    "ALLOWED_COUNTRIES": "US,CA",
    // Cookie signing key. Fine to keep here for a private repo / one-weekend
    // party game. To harden later: remove this line and instead run
    //   npx wrangler secret put SESSION_SECRET
    "SESSION_SECRET": "2307eaf85d607f5645d44c6d0260ab9d97876e52e9accdb799ce0851d3d7e55a"
  }
}
